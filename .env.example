# Server
PORT=5000
NODE_ENV=development

# Database — bittasini tanlang
# 1) To'liq connection string (Neon / Supabase / Railway uchun qulay)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# 2) Yoki alohida parametrlar
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=local_pickup_db

# Auth
JWT_SECRET=change_this_to_a_long_random_secure_string_minimum_32_chars
JWT_EXPIRES_IN=90d

# Telegram bildirishnomalar (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
